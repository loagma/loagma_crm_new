# =====================================================================
# Loagma CRM — server .env template
# Copy to .env and fill in the values. Only keys the CRM uses.
# =====================================================================

# --- App
APP_NAME=LoagmaCRM
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-api-domain
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# --- Auth — REQUIRED: JWT login looks up staff in deli_staff
AUTH_GUARD=api
JWT_SECRET=

# --- Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=loagma_new
DB_USERNAME=
DB_PASSWORD=

# --- Only for a TiDB / SSL database (path to CA certificate). Leave unset for MariaDB.
# MYSQL_ATTR_SSL_CA=

# --- Drivers (file/sync — no Redis, no DB cache tables)
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# --- Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Knowlarity (cloud calls, recordings, webhook)
KNOWLARITY_SR_API_KEY=
KNOWLARITY_APP_ACCESS_KEY=
KNOWLARITY_SR_NUMBER=
KNOWLARITY_BASE_URL=https://kpi.knowlarity.com/Basic/v1/account
KNOWLARITY_WEBHOOK_SECRET=

# --- Optional: road-snapped route history (leave empty to turn off)
# OSRM_URL=
